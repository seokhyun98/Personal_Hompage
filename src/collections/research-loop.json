{
  "intendedUse": "infographic",
  "thesis": "Body-state-aware interaction — systems that estimate the user's momentary capacity in real time and decide what, when, how — and whether — to intervene.",
  "problemStatement": "Human capacity shifts by the second — load, fatigue, stress — and decades of adaptive-systems research let interfaces respond to context and traits. The bottleneck is knowing what responding costs. As proactive AI reaches the body — steering muscles, nudging balance, interrupting drivers — those costs rarely enter the decision, so systems cannot tell when not to act.",
  "approachStatement": "One loop, extending ability-based design from stable traits to momentary state: 1 · Read the state — estimate capacity, with its uncertainty, from behavioral and physiological signals → 2 · Act on it — state-conditioned adaptation, actuation, and information delivery → 3 · Close the loop — measure what each intervention costs. Three testbeds vary the timescale and cost currency: driving (seconds), rehabilitation (sessions), industrial work (cumulative).",
  "board": {
    "label": "Program Map",
    "caption": "Columns follow the loop; rows are the capacities being read and written. Every study has a coordinate — c.13 spans two phases.",
    "loopBackLabel": "cost decides when (not) to intervene",
    "placeholder": "Click a phase for details.",
    "phases": [
      {
        "id": "read",
        "num": "1",
        "name": "Read the State",
        "sub": "signals → capacity estimate",
        "goal": "Sense behavioral and physiological signals — touch, gaze, posture, tactile pressure, pupil, EDA, EMG — and turn them, via statistical and ML models, into estimates of the user's momentary state and perceptual limits: cognitive load, information demand, force and intent, muscle state, and perceptual thresholds.",
        "groups": [
          {
            "label": "Signals Acquired",
            "items": [
              "Touch Kinematics",
              "Gaze + Glances",
              "Posture / IMU",
              "High-Resolution Tactile Pressure",
              "Pupil Diameter",
              "EDA",
              "EMG"
            ]
          },
          {
            "label": "States + Perceptual Limits Estimated (Statistical + ML Models)",
            "items": [
              "Cognitive Load",
              "Performance Breakdown Points",
              "Information Demand Timing",
              "Force + Intent",
              "Muscle State",
              "Perceptual Thresholds (DT/JND)"
            ]
          },
          {
            "label": "Representative Work",
            "items": [
              "Touchscreens in Motion [c.13]",
              "TimelyTale [c.7]",
              "Adaptive Walker [c.9]",
              "CPR Glove [c.15]",
              "Optical-Flow JND [j.1]",
              "EMG Muscle-State Estimation (ongoing)"
            ]
          }
        ],
        "keyImpact": "Different signals, same problem: turn a noisy continuous stream into the estimate an intervention decision needs — with its uncertainty carried into that decision."
      },
      {
        "id": "write",
        "num": "2",
        "name": "Act on It",
        "sub": "state-conditioned interventions",
        "goal": "Build the intervention repertoire — interface adaptation, muscle-level actuation grounded in personalized biomechanical simulation, perceptual-threshold modulation, timed information delivery — and condition it on the estimated state.",
        "groups": [
          {
            "label": "Intervention Channels",
            "items": [
              "Adaptive UI (profile × state)",
              "EMS Muscle Stimulation",
              "Vestibular Stimulation",
              "Thermal + Pressure",
              "Vibrotactile Guidance",
              "Reflex-Based Cues",
              "Timed Information Delivery"
            ]
          },
          {
            "label": "Representative Work",
            "items": [
              "Adaptive Touchscreen [c.14]",
              "TelePulse [c.11]",
              "ErgoPulse [c.5]",
              "Vestibular Stimulation [c.1, c.3]",
              "WatchCap [c.6]",
              "Flip-Pelt [c.8]",
              "eHMI [c.2, c.12]",
              "Multisensory Attractors [j.2, p.1]"
            ]
          }
        ],
        "keyImpact": "A palette of body channels — UI, vestibular, thermal, vibrotactile, muscle-level EMS — built to be conditioned on estimated momentary state, not only context or stable traits."
      },
      {
        "id": "loop",
        "num": "3",
        "name": "Close the Loop",
        "sub": "count the cost of intervening",
        "goal": "Quantify what intervening itself costs — switching, attention, interruption, alarm fatigue, trust — for body-level interventions, where such costs are largely unmeasured, and find where acting beats staying silent: over seconds (driving), sessions (rehabilitation), and cumulative exposure (industrial work). My current studies target this gap.",
        "groups": [
          {
            "label": "Cost Currencies",
            "items": [
              "Post-Switch Performance Dip",
              "Off-Road Glance Re-Search",
              "Interruption + Task Break",
              "Alarm Desensitization",
              "Trust + Compliance",
              "Motion Sickness"
            ]
          },
          {
            "label": "Representative Work",
            "items": [
              "Off-Road Glance Cost [c.13]",
              "Motion-Sickness Cost [c.4, c.10]",
              "Adaptation-Cost Study (planned)",
              "EMG-Conditioned Rehab (planned)",
              "AR Injury Prevention → Field Deployment (planned)"
            ]
          }
        ],
        "keyImpact": "Mixed-initiative research priced interruption on the desktop; body-level interventions — EMS, vestibular, in-car — need the same cost accounting before systems can know when not to act."
      }
    ],
