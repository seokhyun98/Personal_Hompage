---
import researchLoopData from "../../collections/research-loop.json";

const board = researchLoopData.board;
const phases = board.phases;
const cellItems = new Map(
  board.cells.map((cell) => [`${cell.phase}-${cell.axis}`, cell.items])
);
---

<section id="research-goals" class="relative z-20 mx-auto mt-12 w-full max-w-5xl px-7 xl:px-0">
  <h2 class="flex flex-wrap items-baseline gap-x-2 text-2xl font-bold text-neutral-900 dark:text-white">
    Research Goals : <span class="intro-thesis">{researchLoopData.thesis}</span>
  </h2>

  <div class="intro-block mt-2">
    <p class="intro-label">Problem</p>
    <p class="intro-text">{researchLoopData.problemStatement}</p>
    <p class="intro-label">Our Approach</p>
    <p class="intro-text">{researchLoopData.approachStatement}</p>
  </div>

  <div class="loop-board mt-5" data-active-phase="">
    <p class="intro-label">{board.label}</p>
    <p class="intro-text">{board.caption}</p>

    <div class="loop-arc" aria-hidden="true">
      <span class="loop-arc-label">{board.loopBackLabel}</span>
    </div>

    <div class="board-grid">
      <div class="board-corner" aria-hidden="true"></div>
      {
        phases.map((phase, idx) => (
          <button
            type="button"
            class={`phase-card${idx > 0 ? " has-arrow" : ""}`}
            data-phase-btn
            data-phase-id={phase.id}
            aria-pressed="false"
          >
            <span class="phase-name">
              <span class="phase-num" aria-hidden="true">{phase.num}</span>
              {phase.name}
            </span>
            <span class="phase-sub">{phase.sub}</span>
          </button>
        ))
      }

      {
        board.axes.map((axis) => (
          <>
            <div class="matrix-cap-head">
              <span class={`matrix-cap-name axis-${axis.id}`}>{axis.name}</span>
              <span class="matrix-cap-sub">{axis.sub}</span>
            </div>
            {phases.map((phase) => (
              <div class="matrix-cell" data-phase={phase.id}>
                <span class="matrix-cell-phase">
                  <span class="phase-num" aria-hidden="true">{phase.num}</span>
                  {phase.name}
                </span>
                {(cellItems.get(`${phase.id}-${axis.id}`) ?? []).map((item) => (
                  <span class={`matrix-chip tier-${item.tier} chip-${axis.id}`}>
                    {item.label}
                    {item.ids.length > 0 && <span class="chip-ids">[{item.ids.join(", ")}]</span>}
                    {item.award && <span class="chip-award">★ {item.award}</span>}
                    {item.sub && <span class="chip-sub">{item.sub}</span>}
                  </span>
                ))}
              </div>
            ))}
          </>
        ))
      }
    </div>

    <div class="detail-area">
      <div class="detail-placeholder" data-panel-default>
        <ul class="insight-list">
          {
            phases.map((phase) => (
              <li>
                <span class="phase-num" aria-hidden="true">{phase.num}</span>
                <span class="insight-text">{phase.keyImpact}</span>
              </li>
            ))
          }
        </ul>
        <p class="panel-placeholder"><span class="panel-placeholder-highlight">{board.placeholder}</span></p>
      </div>

      {
        phases.map((phase) => (
          <div class="detail-card" data-panel-content data-phase-id={phase.id} aria-hidden="true">
            <div class="detail-card-header">
              <span class="phase-num" aria-hidden="true">{phase.num}</span>
              <span class="detail-card-name">{phase.name}</span>
              <span class="detail-card-sublabel">({phase.sub})</span>
            </div>
            <div class="detail-card-body">
              <p class="panel-label">Goal</p>
              <p class="panel-goal">{phase.goal}</p>

              {phase.groups.map((group) => (
                <>
                  <p class="panel-label">{group.label}</p>
                  <div class="panel-badges">{group.items.map((item) => <span class="data-badge">{item}</span>)}</div>
                </>
              ))}

              <p class="panel-label">Key Insight</p>
              <p class="panel-impact">{phase.keyImpact}</p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="matrix-legend">
      <span class="matrix-legend-note">{board.legendNote}</span>
      {
        board.legend.map((entry) => (
          <span class={`matrix-chip matrix-legend-chip tier-${entry.tier} chip-legend`}>{entry.label}</span>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  function setupLoopBoard() {
    const boardEl = document.querySelector(".loop-board");
    if (!boardEl) return;

    const phaseBtns = boardEl.querySelectorAll("[data-phase-btn]");
    const panelDefault = boardEl.querySelector("[data-panel-default]");
    const panelContents = boardEl.querySelectorAll("[data-panel-content]");

    let activePhaseId = "";

    function setActive(phaseId) {
      activePhaseId = phaseId;
      boardEl.setAttribute("data-active-phase", phaseId || "");

      phaseBtns.forEach((btn) => {
        btn.setAttribute("aria-pressed", btn.getAttribute("data-phase-id") === phaseId ? "true" : "false");
      });

      if (phaseId) {
        panelDefault?.setAttribute("aria-hidden", "true");
        panelContents.forEach((panel) => {
          panel.setAttribute("aria-hidden", panel.getAttribute("data-phase-id") === phaseId ? "false" : "true");
        });
      } else {
        panelDefault?.setAttribute("aria-hidden", "false");
        panelContents.forEach((panel) => panel.setAttribute("aria-hidden", "true"));
      }
    }

    phaseBtns.forEach((btn) => {
      const phaseId = btn.getAttribute("data-phase-id") || "";
      btn.addEventListener("click", () => setActive(activePhaseId === phaseId ? "" : phaseId));
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupLoopBoard);
  } else {
    setupLoopBoard();
  }
</script>

<style>
  .intro-thesis {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    color: rgb(38 38 38);
  }

  .intro-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(82 82 82);
    margin-top: 1rem;
    margin-bottom: 0.25rem;
  }

  .intro-text {
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgb(64 64 64);
  }

  html.dark .intro-thesis {
    color: rgb(250 250 250);
  }

  html.dark .intro-label {
    color: rgb(163 163 163);
  }

  html.dark .intro-text {
    color: rgb(212 212 212);
  }

  /* One integrated board: the loop as columns, the three capacities as rows. */
  .loop-board {
    border-radius: 1rem;
    border: 1px dashed rgb(212 212 212);
    background: rgb(250 250 250);
    padding: 0.25rem 1rem 1rem;
  }

  html.dark .loop-board {
    border-color: rgb(64 64 64);
    background: rgba(23 23 23 / 0.5);
  }

  .loop-board .intro-label {
    margin-top: 0.75rem;
  }

  /* Loop-back arc: S4 feeds S1 — the claim that cost governs the next read. */
  .loop-arc {
    position: relative;
    height: 14px;
    margin-top: 1.9rem;
    margin-left: calc(116px + (100% - 116px) / 6);
    margin-right: calc((100% - 116px) / 6);
    border: 1px dashed rgb(163 163 163);
    border-bottom: none;
    border-radius: 10px 10px 0 0;
  }

  .loop-arc::after {
    content: "";
    position: absolute;
    left: -5px;
    bottom: -5px;
    width: 0;
    height: 0;
    border-left: 4.5px solid transparent;
    border-right: 4.5px solid transparent;
    border-top: 6px solid rgb(163 163 163);
  }

  .loop-arc-label {
    position: absolute;
    top: -1.25em;
    left: 50%;
    transform: translateX(-50%);
    white-space: nowrap;
    font-size: 0.68rem;
    font-weight: 600;
    color: rgb(115 115 115);
  }

  html.dark .loop-arc {
    border-color: rgb(115 115 115);
  }

  html.dark .loop-arc::after {
    border-top-color: rgb(115 115 115);
  }

  html.dark .loop-arc-label {
    color: rgb(163 163 163);
  }

  .board-grid {
    display: grid;
    grid-template-columns: 108px repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin-top: 2px;
  }

  /* Phase cards: the loop's header row. Neutral surfaces so the stage dots and
     capacity colors below stay the only strong hues on the board. */
  .phase-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    text-align: left;
    border-radius: 0.8rem;
    border: 2px solid rgb(229 229 229);
    background: rgb(255 255 255);
    padding: 0.45rem 0.75rem;
    cursor: pointer;
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease, opacity 200ms ease;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .phase-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.1);
  }

  .phase-card.has-arrow::before {
    content: "→";
    position: absolute;
    left: -9px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.72rem;
    line-height: 1;
    color: rgb(163 163 163);
  }

  /* Invite pulse while nothing is selected. */
  .loop-board[data-active-phase=""] .phase-card {
    animation: phase-pulse 2.5s ease-in-out infinite;
  }

  @keyframes phase-pulse {
    0%, 100% {
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
    }
    50% {
      box-shadow: 0 0 0 2px rgb(163 163 163 / 0.35), 0 4px 14px rgba(0, 0, 0, 0.1);
    }
  }

  .phase-card[aria-pressed="true"] {
    border-color: rgb(64 64 64);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.12);
  }

  .loop-board:not([data-active-phase=""]) .phase-card[aria-pressed="false"] {
    opacity: 0.5;
    filter: saturate(0.75);
  }

  /* Numbered badge: the loop axis speaks in sequence (1 → 2 → 3),
     leaving color free to encode the capacity axis alone. */
  .phase-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.05rem;
    height: 1.05rem;
    border-radius: 9999px;
    border: 1.5px solid rgb(115 115 115);
    color: rgb(64 64 64);
    font-size: 0.64rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  html.dark .phase-num {
    border-color: rgb(163 163 163);
    color: rgb(212 212 212);
  }

  .phase-name {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: rgb(23 23 23);
  }

  .phase-sub {
    font-size: 0.66rem;
    font-weight: 500;
    color: rgb(115 115 115);
  }

  html.dark .phase-card {
    border-color: rgb(64 64 64);
    background: rgb(23 23 23 / 0.7);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }

  html.dark .phase-card:hover {
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.3);
  }

  html.dark .phase-card[aria-pressed="true"] {
    border-color: rgb(212 212 212);
    box-shadow: 0 10px 22px rgba(0, 0, 0, 0.35);
  }

  @keyframes phase-pulse-dark {
    0%, 100% {
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
    }
    50% {
      box-shadow: 0 0 0 2px rgb(163 163 163 / 0.3), 0 4px 14px rgba(0, 0, 0, 0.35);
    }
  }

  html.dark .loop-board[data-active-phase=""] .phase-card {
    animation-name: phase-pulse-dark;
  }

  html.dark .phase-name {
    color: rgb(245 245 245);
  }

  html.dark .phase-sub {
    color: rgb(163 163 163);
  }

  /* Capacity heads (rows): the three abilities, phrased in human terms. */
  .matrix-cap-head {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.15rem;
  }

  .matrix-cap-name {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .matrix-cap-sub {
    font-size: 0.63rem;
    font-weight: 500;
    line-height: 1.3;
    color: rgb(115 115 115);
  }

  html.dark .matrix-cap-sub {
    color: rgb(163 163 163);
  }

  .axis-perceptual {
    color: rgb(180 83 9);
  }

  .axis-cognitive {
    color: rgb(124 58 237);
  }

  .axis-motor {
    color: rgb(2 132 199);
  }

  html.dark .axis-perceptual {
    color: rgb(251 191 36);
  }

  html.dark .axis-cognitive {
    color: rgb(196 181 253);
  }

  html.dark .axis-motor {
    color: rgb(125 211 252);
  }

  .matrix-cell {
    border-radius: 0.6rem;
    border: 1px solid rgb(229 229 229);
    background: rgb(255 255 255);
    padding: 0.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    align-content: flex-start;
  }

  html.dark .matrix-cell {
    border-color: rgb(64 64 64);
    background: rgb(23 23 23 / 0.6);
  }

  .matrix-cell {
    transition: opacity 240ms ease, filter 240ms ease;
  }

  /* Cross-highlight: while a phase is selected, fade the other columns' cells. */
  .loop-board[data-active-phase="read"] .matrix-cell:not([data-phase="read"]),
  .loop-board[data-active-phase="write"] .matrix-cell:not([data-phase="write"]),
  .loop-board[data-active-phase="loop"] .matrix-cell:not([data-phase="loop"]) {
    opacity: 0.35;
    filter: saturate(0.7);
  }

  .matrix-cell-phase {
    display: none;
  }

  .matrix-chip {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.3rem;
    row-gap: 0.06rem;
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.3;
    padding: 0.18rem 0.45rem;
    border-radius: 0.35rem;
    border: 1px solid transparent;
    text-decoration: none;
  }

  /* Award badge: surfaces the quality signal (Best Paper / Honorable Mention) on the map itself. */
  .chip-award {
    align-self: center;
    font-size: 0.56rem;
    font-weight: 700;
    line-height: 1.4;
    padding: 0 0.28rem;
    border-radius: 0.25rem;
    background: rgb(253 230 138);
    color: rgb(23 23 23);
    white-space: nowrap;
  }

  html.dark .chip-award {
    background: rgb(120 53 15 / 0.5);
    color: rgb(254 243 199);
  }

  /* Sub line: testbed · timescale · inherited asset — makes planned chips read as an agenda. */
  .chip-sub {
    width: 100%;
    font-size: 0.6rem;
    font-weight: 500;
    line-height: 1.35;
    opacity: 0.85;
  }

  .chip-ids {
    font-size: 0.62rem;
    font-weight: 500;
    opacity: 0.75;
  }

  .tier-core.chip-perceptual {
    background: rgb(254 243 199);
    color: rgb(120 53 15);
    border-color: rgb(253 224 71 / 0.7);
  }

  .tier-core.chip-cognitive {
    background: rgb(237 233 254);
    color: rgb(76 29 149);
    border-color: rgb(196 181 253 / 0.7);
  }

  .tier-core.chip-motor {
    background: rgb(224 242 254);
    color: rgb(7 89 133);
    border-color: rgb(125 211 252 / 0.7);
  }

  html.dark .tier-core.chip-perceptual {
    background: rgb(120 53 15 / 0.45);
    color: rgb(253 230 138);
    border-color: rgb(180 83 9);
  }

  html.dark .tier-core.chip-cognitive {
    background: rgb(139 92 246 / 0.3);
    color: rgb(233 213 255);
    border-color: rgb(139 92 246 / 0.6);
  }

  html.dark .tier-core.chip-motor {
    background: rgb(56 189 248 / 0.25);
    color: rgb(186 230 253);
    border-color: rgb(56 189 248 / 0.6);
  }

  .matrix-chip.tier-collab {
    background: transparent;
    color: rgb(82 82 82);
    border-color: rgb(163 163 163);
  }

  html.dark .matrix-chip.tier-collab {
    color: rgb(212 212 212);
    border-color: rgb(115 115 115);
  }

  .matrix-chip.tier-planned {
    background: transparent;
    color: rgb(115 115 115);
    border-style: dashed;
    border-color: rgb(163 163 163);
  }

  html.dark .matrix-chip.tier-planned {
    color: rgb(163 163 163);
    border-color: rgb(115 115 115);
  }

  /* Detail panel: opens under the board when a phase is selected. */
  .detail-area {
    margin-top: 0.75rem;
  }

  .detail-placeholder[aria-hidden="true"],
  .detail-card[aria-hidden="true"] {
    display: none;
  }

  .detail-placeholder {
    padding: 0.6rem 0.5rem 0.4rem;
  }

  /* The three key insights stay visible without a click — skimmers and PDF readers see the argument. */
  .insight-list {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: 0.65rem;
  }

  .insight-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .insight-list .phase-num {
    margin-top: 0.12rem;
  }

  .insight-text {
    font-size: 0.78rem;
    line-height: 1.5;
    color: rgb(82 82 82);
  }

  html.dark .insight-text {
    color: rgb(163 163 163);
  }

  .panel-placeholder {
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.5;
    color: rgb(64 64 64);
    text-align: center;
  }

  .panel-placeholder-highlight {
    background: linear-gradient(transparent 60%, rgba(251, 191, 36, 0.4) 60%);
    padding: 0 2px;
  }

  html.dark .panel-placeholder {
    color: rgb(212 212 212);
  }

  html.dark .panel-placeholder-highlight {
    background: linear-gradient(transparent 60%, rgba(251, 191, 36, 0.35) 60%);
  }

  .detail-card {
    border-radius: 0.8rem;
    border: 2px solid rgb(212 212 212);
    background: rgb(255 255 255);
    overflow: hidden;
    max-height: 320px;
    display: flex;
    flex-direction: column;
    animation: detail-card-appear 280ms ease;
  }

  @keyframes detail-card-appear {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .detail-card-header {
    padding: 0.5rem 1rem;
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
  }

  .detail-card-header .phase-num {
    align-self: center;
  }

  .detail-card-name {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(23 23 23);
  }

  .detail-card-sublabel {
    font-size: 0.7rem;
    font-weight: 600;
    color: rgb(82 82 82);
  }

  .detail-card-body {
    padding: 0 1rem 1rem 1rem;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(115 115 115 / 0.5) transparent;
    flex: 1;
    min-height: 0;
  }

  .detail-card-body::-webkit-scrollbar {
    width: 6px;
  }

  .detail-card-body::-webkit-scrollbar-thumb {
    background: rgba(115 115 115 / 0.4);
    border-radius: 3px;
  }

  .detail-card-body .panel-label {
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: rgb(115 115 115);
    margin-top: 0.75rem;
    margin-bottom: 0.35rem;
  }

  .detail-card-body .panel-label:first-child {
    margin-top: 0.35rem;
  }

  .panel-goal,
  .panel-impact {
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.45;
    color: rgb(23 23 23);
  }

  .panel-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .data-badge {
    font-size: 0.72rem;
    padding: 0.2rem 0.45rem;
    background: rgb(229 229 229);
    border-radius: 0.35rem;
    font-weight: 600;
    color: rgb(64 64 64);
  }

  html.dark .detail-card {
    border-color: rgb(82 82 82);
    background: rgb(23 23 23 / 0.7);
  }

  html.dark .detail-card-name,
  html.dark .panel-goal,
  html.dark .panel-impact {
    color: rgb(250 250 250);
  }

  html.dark .detail-card-sublabel,
  html.dark .detail-card-body .panel-label {
    color: rgb(163 163 163);
  }

  html.dark .detail-card-body {
    scrollbar-color: rgba(163 163 163 / 0.5) transparent;
  }

  html.dark .detail-card-body::-webkit-scrollbar-thumb {
    background: rgba(163 163 163 / 0.5);
  }

  html.dark .data-badge {
    background: rgb(64 64 64);
    color: rgb(212 212 212);
  }

  .matrix-legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .matrix-legend-note {
    font-size: 0.68rem;
    font-weight: 500;
    color: rgb(115 115 115);
    margin-right: 0.2rem;
  }

  html.dark .matrix-legend-note {
    color: rgb(163 163 163);
  }

  .matrix-legend-chip {
    cursor: default;
  }

  /* Legend samples stay axis-neutral: fill style (not color) carries the tier meaning. */
  .tier-core.chip-legend {
    background: rgb(229 229 229);
    color: rgb(38 38 38);
    border-color: rgb(163 163 163 / 0.7);
  }

  html.dark .tier-core.chip-legend {
    background: rgb(64 64 64);
    color: rgb(245 245 245);
    border-color: rgb(115 115 115);
  }

  @media (prefers-reduced-motion: reduce) {
    .phase-card,
    .matrix-cell,
    .detail-card {
      transition: none !important;
      animation: none !important;
    }
    .loop-board[data-active-phase=""] .phase-card {
      animation: none !important;
    }
  }

  @media (max-width: 768px) {
    .loop-board {
      margin-left: 0;
      margin-right: 0;
      width: 100%;
    }

    .loop-arc {
      display: none;
    }

    /* Board collapses to a single column: phase cards stack as a compact strip,
       then each capacity becomes a labeled group whose three cells read
       top-to-bottom as the loop storyline. */
    .board-grid {
      grid-template-columns: 1fr;
      gap: 8px;
      margin-top: 0.75rem;
    }

    .board-corner {
      display: none;
    }

    .phase-card.has-arrow::before {
      display: none;
    }

    .matrix-cap-head {
      flex-direction: row;
      align-items: baseline;
      gap: 0.4rem;
      margin-top: 0.5rem;
    }

