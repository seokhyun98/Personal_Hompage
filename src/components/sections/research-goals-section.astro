---
import researchProgram from "../../collections/research-loop.json";

const previewLanes = researchProgram.lanes;
const showCurrentNext = true;
---

<section
  id="research-goals"
  class="research-goals relative z-20 mx-auto mt-14 w-full max-w-5xl px-7 xl:px-0"
  aria-labelledby="research-goals-heading"
>
  <header class="research-heading">
    <p class="research-eyebrow">{researchProgram.eyebrow}</p>
    <h2 id="research-goals-heading">Research Goals</h2>
  </header>

  <div class="program-summary">
    <p class="program-title">{researchProgram.title}</p>
    <p class="program-statement">{researchProgram.statement}</p>
  </div>

  <div class="capacity-loop" data-capacity-loop>
    <div class="loop-intro">
      <p>{researchProgram.readingHint}</p>
      <span>Select a row, step, or card to explore</span>
    </div>

    <div class="stage-row">
      <div class="stage-corner" aria-hidden="true"></div>
      {
        researchProgram.stages.map((stage) => (
          <button
            type="button"
            class="stage-heading"
            data-loop-trigger
            data-trigger-type="stage"
            data-stage={stage.id}
            data-caption-label={`Shared method · Step ${stage.number}`}
            data-caption-title={stage.label}
            data-caption-text={stage.prompt}
            aria-controls="research-loop-caption"
            aria-label={`${stage.label}. ${stage.meta}. ${stage.prompt}`}
            aria-pressed="false"
          >
            <span class="stage-number" aria-hidden="true">{stage.number}</span>
            <span class="stage-copy">
              <strong>{stage.label}</strong>
              <small>{stage.meta}</small>
            </span>
            {stage.id === "verify" && <span class="stage-loopback" aria-hidden="true">↺</span>}
          </button>
        ))
      }
    </div>

    <div class="lane-rows">
      {
        previewLanes.map((lane) => (
          <article
            class="lane-row"
            data-lane-row
            data-lane={lane.id}
            aria-labelledby={`lane-${lane.id}-heading`}
          >
            <button
              type="button"
              class="lane-heading"
              data-loop-trigger
              data-trigger-type="lane"
              data-lane={lane.id}
              data-caption-label={`${lane.label} · capacity loop`}
              data-caption-title={lane.subtitle}
              data-caption-text={lane.story}
              aria-controls="research-loop-caption"
              aria-label={`${lane.label}: ${lane.story}`}
              aria-pressed="false"
            >
              <span class="lane-number" aria-hidden="true">{lane.number}</span>
              <span>
                <strong id={`lane-${lane.id}-heading`}>{lane.label}</strong>
                <small>{lane.subtitle}</small>
              </span>
            </button>

            {
              lane.cards.map((card, index) => {
                const stage = researchProgram.stages.find((item) => item.id === card.stage);
                const detailId = `research-detail-${lane.id}-${card.id}`;
                return (
                  <div class="loop-cell" data-stage={card.stage}>
                    <span class="mobile-stage-label">{stage?.label}</span>
                    <button
                      type="button"
                      class="research-card"
                      data-loop-trigger
                      data-trigger-type="card"
                      data-lane={lane.id}
                      data-stage={card.stage}
                      data-card-id={card.id}
                      data-card-works={JSON.stringify(card.works)}
                      data-inline-detail-id={detailId}
                      data-caption-label={`${lane.label} · ${stage?.label ?? ""}`}
                      data-caption-title={card.title}
                      data-caption-text={card.caption}
                      aria-controls={`research-loop-caption ${detailId}`}
                      aria-expanded="false"
                      aria-label={`${lane.label}, ${stage?.label ?? ""}: ${card.title}. ${card.caption}`}
                      aria-pressed="false"
                    >
                      <span>{card.title}</span>
                    </button>
                    <div
                      id={detailId}
                      class="mobile-card-detail"
                      data-mobile-card-detail
                      role="region"
                      aria-label={`${card.title} related work`}
                      aria-live="polite"
                      hidden
                    >
                      <p class="mobile-detail-caption">{card.caption}</p>
                      <div class="mobile-detail-works">
                        {card.works.map((work) => (
                          <span class="evidence-badge">
                            <span class="evidence-name">{work.name}</span>
                            <span class="evidence-refs">
                              {work.refs.map((ref) => (
                                <a
                                  href={`#pub-${ref}`}
                                  class="evidence-ref"
                                  aria-label={`Open ${work.name}, publication ${ref}`}
                                >
                                  [{ref}]
                                </a>
                              ))}
                            </span>
                          </span>
                        ))}
                      </div>
                    </div>
                    {index < lane.cards.length - 1 && <span class="cell-arrow" aria-hidden="true">→</span>}
                  </div>
                );
              })
            }
          </article>
        ))
      }
    </div>

    <div id="research-loop-caption" class="loop-caption" data-loop-caption>
      <div class="loop-caption-copy" role="status" aria-live="polite" aria-atomic="true">
        <p class="caption-label" data-caption-label>How to read this map</p>
        <p class="caption-title" data-caption-title>One method, three human capacities</p>
        <p class="caption-text" data-caption-text>
          Select a card to see the systems and studies behind each part of the cycle.
        </p>
      </div>
      <div class="caption-works" data-caption-works aria-label="Related work"></div>
    </div>
  </div>

  {
    showCurrentNext && (
      <aside class="current-next" aria-labelledby="current-next-heading">
        <p id="current-next-heading" class="current-next-label">{researchProgram.currentNext.label}</p>
        <div class="next-groups">
          {researchProgram.currentNext.groups.map((group) => (
            <div class="next-group" data-lane={group.lane}>
              <div class="next-meta">
                <span class="next-dot" aria-hidden="true"></span>
                <span>{group.laneLabel}</span>
                <small>{group.status}</small>
              </div>
              <p>{group.title}</p>
            </div>
          ))}
        </div>
      </aside>
    )
  }
</section>

<script is:inline>
  function setupCapacityLoop() {
    document.querySelectorAll("[data-capacity-loop]").forEach((loop) => {
      const triggers = Array.from(loop.querySelectorAll("[data-loop-trigger]"));
      const cards = Array.from(loop.querySelectorAll('[data-trigger-type="card"]'));
      const cardDetails = Array.from(loop.querySelectorAll("[data-mobile-card-detail]"));
      const detailsById = new Map(cardDetails.map((detail) => [detail.id, detail]));
      const laneTriggers = Array.from(loop.querySelectorAll('[data-trigger-type="lane"]'));
      const stageTriggers = Array.from(loop.querySelectorAll('[data-trigger-type="stage"]'));
      const caption = loop.querySelector("[data-loop-caption]");
      const captionLabel = caption?.querySelector("[data-caption-label]");
      const captionTitle = caption?.querySelector("[data-caption-title]");
      const captionText = caption?.querySelector("[data-caption-text]");
      const captionWorks = caption?.querySelector("[data-caption-works]");
      let pinnedTrigger = null;
      let shownTrigger = null;

      const defaults = {
        label: captionLabel?.textContent || "",
        title: captionTitle?.textContent || "",
        text: captionText?.textContent || "",
      };

      function renderWorks(works) {
        if (!captionWorks) return;
        captionWorks.replaceChildren();
        works.forEach((work) => {
          const badge = document.createElement("span");
          badge.className = "evidence-badge";

          const name = document.createElement("span");
          name.className = "evidence-name";
          name.textContent = work.name;
          badge.appendChild(name);

          const refs = document.createElement("span");
          refs.className = "evidence-refs";
          work.refs.forEach((ref) => {
            const link = document.createElement("a");
            link.href = `#pub-${ref}`;
            link.textContent = `[${ref}]`;
            link.className = "evidence-ref";
            link.setAttribute("aria-label", `Open ${work.name}, publication ${ref}`);
            refs.appendChild(link);
          });

          badge.appendChild(refs);
          captionWorks.appendChild(badge);
        });
      }

      function showTrigger(trigger) {
        const type = trigger.getAttribute("data-trigger-type");
        const lane = trigger.getAttribute("data-lane");
        const stage = trigger.getAttribute("data-stage");
        shownTrigger = trigger;
        loop.classList.add("has-highlight");

        laneTriggers.forEach((item) => {
          item.classList.toggle("is-highlighted", Boolean(lane) && item.getAttribute("data-lane") === lane);
        });

        stageTriggers.forEach((item) => {
          item.classList.toggle("is-highlighted", Boolean(stage) && item.getAttribute("data-stage") === stage);
        });

        cards.forEach((card) => {
          const sameLane = Boolean(lane) && card.getAttribute("data-lane") === lane;
          const sameStage = Boolean(stage) && card.getAttribute("data-stage") === stage;
          const isActive = card === trigger;
          const isRelated =
            type === "lane" ? sameLane :
            type === "stage" ? sameStage :
            type === "card" ? sameLane || sameStage :
            false;

          card.classList.toggle("is-active", isActive);
          card.classList.toggle("is-related", isRelated);
          card.classList.toggle("is-path", type === "card" && sameLane);
          card.classList.toggle("is-column", type === "card" && sameStage);

          const revealDetail = type === "card" && isActive;
          const detailId = card.getAttribute("data-inline-detail-id") || "";
          const detail = detailsById.get(detailId);
          card.setAttribute("aria-expanded", String(revealDetail));
          if (detail) detail.hidden = !revealDetail;
        });

        if (captionLabel) captionLabel.textContent = trigger.getAttribute("data-caption-label") || "";
        if (captionTitle) captionTitle.textContent = trigger.getAttribute("data-caption-title") || "";
        if (captionText) captionText.textContent = trigger.getAttribute("data-caption-text") || "";

        const workData = trigger.getAttribute("data-card-works");
        let works = [];
        if (workData) {
          try {
            works = JSON.parse(workData);
          } catch {
            works = [];
          }
        }
        renderWorks(works);
      }

      function resetLoop() {
        loop.classList.remove("has-highlight");
        triggers.forEach((trigger) => {
          trigger.classList.remove("is-highlighted", "is-active", "is-related", "is-path", "is-column");
          trigger.setAttribute("aria-pressed", "false");
        });
        cards.forEach((card) => card.setAttribute("aria-expanded", "false"));
        cardDetails.forEach((detail) => { detail.hidden = true; });
        if (captionLabel) captionLabel.textContent = defaults.label;
        if (captionTitle) captionTitle.textContent = defaults.title;
        if (captionText) captionText.textContent = defaults.text;
        renderWorks([]);
        shownTrigger = null;
      }

      function pinTrigger(trigger) {
        const shouldClear = pinnedTrigger === trigger;
        triggers.forEach((item) => item.setAttribute("aria-pressed", "false"));
        pinnedTrigger = shouldClear ? null : trigger;

        if (pinnedTrigger) {
          pinnedTrigger.setAttribute("aria-pressed", "true");
          showTrigger(pinnedTrigger);
        } else {
          resetLoop();
        }
      }

      function focusRelatedWork(trigger) {
        if (trigger.getAttribute("data-trigger-type") !== "card") return;
        const useInlineDetail = window.matchMedia("(max-width: 768px)").matches;
        const detailId = trigger.getAttribute("data-inline-detail-id") || "";
        const detail = detailsById.get(detailId);
        const targetRegion = useInlineDetail ? detail : captionWorks;
        const firstLink = targetRegion?.querySelector(".evidence-ref");
        if (firstLink instanceof HTMLElement) firstLink.focus({ preventScroll: true });
      }

      triggers.forEach((trigger) => {
        trigger.addEventListener("mouseenter", () => {
          if (!pinnedTrigger && !loop.contains(document.activeElement)) showTrigger(trigger);
        });
        trigger.addEventListener("focus", () => {
          if (!pinnedTrigger) showTrigger(trigger);
        });
        trigger.addEventListener("click", (event) => {
          const wasPinned = pinnedTrigger === trigger;
          pinTrigger(trigger);
          if (!wasPinned && pinnedTrigger === trigger && event.detail === 0) {
            window.requestAnimationFrame(() => focusRelatedWork(trigger));
          }
        });
      });

      loop.addEventListener("mouseleave", () => {
        if (!pinnedTrigger && !loop.contains(document.activeElement)) resetLoop();
      });

      loop.addEventListener("focusout", () => {
        window.setTimeout(() => {
          if (!pinnedTrigger && !loop.contains(document.activeElement)) resetLoop();
        }, 0);
      });

      loop.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        const returnTarget = pinnedTrigger || shownTrigger;
        if (returnTarget instanceof HTMLElement && document.activeElement !== returnTarget) {
          returnTarget.focus({ preventScroll: true });
        }
        pinnedTrigger = null;
        resetLoop();
        event.preventDefault();
      });
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupCapacityLoop);
  } else {
    setupCapacityLoop();
  }
</script>

<style>
  .research-goals {
    scroll-margin-top: 5.5rem;
  }

  .research-heading {
    margin-bottom: 0.85rem;
  }

  .research-heading h2 {
    margin-top: 0.12rem;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
    color: rgb(23 23 23);
  }

  .research-eyebrow,
  .caption-label,
  .current-next-label,
  .mobile-stage-label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
    color: rgb(115 115 115);
  }

  .program-summary {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
    padding: 0.9rem 1.1rem;
    border: 1px solid rgb(212 212 212);
    border-left: 3px solid rgb(245 158 11);
    border-radius: 0 0.85rem 0.85rem 0;
    background: rgb(250 250 250);
  }

  .program-title {
    padding: 0.28rem 0.55rem;
    border-radius: 999px;
    background: rgb(254 243 199);
    font-size: 0.68rem;
    font-weight: 750;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(146 64 14);
  }

  .program-statement {
    max-width: 47rem;
    font-size: clamp(1rem, 1.7vw, 1.22rem);
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: -0.012em;
    color: rgb(38 38 38);
  }

  .capacity-loop {
    margin-top: 0.75rem;
    padding: 0.85rem;
    border: 1px dashed rgb(212 212 212);
    border-radius: 0.9rem;
  }

  .loop-intro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.45rem 1rem;
    margin-bottom: 0.7rem;
  }

  .loop-intro p {
    font-size: 0.72rem;
    font-weight: 600;
    color: rgb(82 82 82);
  }

  .loop-intro span {
    font-size: 0.61rem;
    font-weight: 650;
    color: rgb(115 115 115);
  }

  .stage-row,
  .lane-row {
    display: grid;
    grid-template-columns: 118px repeat(3, minmax(0, 1fr));
    gap: 0.55rem;
  }

  .stage-row {
    margin-bottom: 0.42rem;
    padding-inline: 0.48rem;
  }

  .stage-heading {
    position: relative;
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.52rem;
    padding: 0.5rem 0.58rem;
    text-align: left;
    border: 0;
    border-bottom: 1px solid rgb(212 212 212);
    background: transparent;
    cursor: pointer;
    transition: border-color 150ms ease, background-color 150ms ease, opacity 150ms ease;
  }

  .stage-heading:not(:last-child)::after {
    content: "→";
    position: absolute;
    right: -0.43rem;
    color: rgb(163 163 163);
    font-size: 0.68rem;
  }

  .stage-heading:hover,
  .stage-heading.is-highlighted {
    border-color: rgb(245 158 11);
    background: rgb(255 251 235);
  }

  .stage-heading:focus-visible {
    border-color: rgb(245 158 11);
    background: rgb(255 251 235);
    outline: 2px solid rgb(217 119 6);
    outline-offset: 1px;
  }

  .stage-number {
    display: inline-flex;
    width: 1.25rem;
    height: 1.25rem;
    flex: 0 0 1.25rem;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: rgb(38 38 38);
    font-size: 0.62rem;
    font-weight: 700;
    color: white;
  }

  .stage-copy {
    min-width: 0;
  }

  .stage-loopback {
    margin-left: auto;
    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1;
    color: rgb(217 119 6);
  }

  .stage-copy strong,
  .stage-copy small {
    display: block;
  }

  .stage-copy strong {
    font-size: 0.75rem;
    color: rgb(38 38 38);
  }

  .stage-copy small {
    margin-top: 0.08rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.58rem;
    color: rgb(115 115 115);
  }

  .lane-rows {
    display: flex;
    flex-direction: column;
    gap: 0.42rem;
  }

  .lane-row {
    --lane-color: rgb(180 83 9);
    --lane-soft: rgb(255 251 235);
    --lane-border: rgb(252 211 77);
    align-items: stretch;
    padding: 0.48rem;
    border: 1px solid rgb(229 229 229);
    border-radius: 0.72rem;
    transition: opacity 150ms ease, border-color 150ms ease;
  }

  .lane-row[data-lane="process"] {
    --lane-color: rgb(109 40 217);
    --lane-soft: rgb(250 245 255);
    --lane-border: rgb(196 181 253);
  }

  .lane-row[data-lane="act"] {
    --lane-color: rgb(3 105 161);
    --lane-soft: rgb(240 249 255);
    --lane-border: rgb(125 211 252);
  }

  .lane-heading {
    display: flex;
    align-items: center;
    gap: 0.42rem;
    padding: 0.35rem;
    text-align: left;
    border: 0;
    border-radius: 0.48rem;
    background: transparent;
    cursor: pointer;
    transition: background-color 150ms ease, opacity 150ms ease;
  }

  .lane-heading:hover,
  .lane-heading.is-highlighted {
    background: var(--lane-soft);
  }

  .lane-heading:focus-visible {
    background: var(--lane-soft);
    outline: 2px solid var(--lane-color);
    outline-offset: 2px;
  }

  .lane-number {
    font-size: 0.58rem;
    font-weight: 700;
    color: rgb(163 163 163);
  }

  .lane-heading strong,
  .lane-heading small {
    display: block;
  }

  .lane-heading strong {
    font-size: 0.8rem;
    font-weight: 750;
    color: var(--lane-color);
  }

  .lane-heading small {
    margin-top: 0.1rem;
    font-size: 0.58rem;
    line-height: 1.3;
    color: rgb(115 115 115);
  }

  .loop-cell {
    position: relative;
    min-width: 0;
  }

  .research-card {
    display: flex;
    width: 100%;
    min-height: 3.15rem;
    align-items: center;
    justify-content: center;
    padding: 0.48rem 0.55rem;
    text-align: center;
    border: 1px solid rgb(212 212 212);
    border-radius: 0.52rem;
    background: rgb(255 255 255);
    cursor: pointer;
    transition: opacity 150ms ease, border-color 150ms ease, background-color 150ms ease;
  }

  .research-card span {
    font-size: 0.7rem;
    font-weight: 700;
    line-height: 1.3;
    color: rgb(38 38 38);
  }

  .research-card:hover,
  .research-card.is-active,
  .research-card[aria-pressed="true"] {
    border-color: var(--lane-color);
    background: var(--lane-soft);
  }

  .research-card:focus-visible {
    border-color: var(--lane-color);
    background: var(--lane-soft);
    outline: 2px solid var(--lane-color);
    outline-offset: 2px;
  }

  .cell-arrow {
    position: absolute;
    top: 50%;
    right: -0.48rem;
    z-index: 2;
    transform: translateY(-50%);
    font-size: 0.64rem;
    color: rgb(163 163 163);
  }

  .mobile-stage-label {
    display: none;
  }

  .capacity-loop.has-highlight .research-card:not(.is-related) {
    border-color: rgb(229 229 229);
    background: rgb(250 250 250);
  }

  .capacity-loop.has-highlight .research-card:not(.is-related) span {
    color: rgb(115 115 115);
  }

  .capacity-loop.has-highlight .research-card.is-path {
    border-color: var(--lane-border);
  }

  .capacity-loop.has-highlight .research-card.is-column {
    border-color: var(--lane-border);
    border-style: dashed;
  }

  .capacity-loop.has-highlight .research-card.is-active {
    border-style: solid;
    border-color: var(--lane-color);
    background: var(--lane-soft);
  }

  .loop-caption {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    margin-top: 0.48rem;
    padding: 0.6rem 0.7rem;
    border-left: 2px solid rgb(245 158 11);
    background: rgb(250 250 250);
  }

  .caption-title {
    margin-top: 0.08rem;
    font-size: 0.74rem;
    font-weight: 750;
    color: rgb(38 38 38);
  }

  .caption-text {
    margin-top: 0.08rem;
    max-width: 43rem;
    font-size: 0.68rem;
    line-height: 1.45;
    color: rgb(82 82 82);
  }

  .caption-works {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.32rem;
    max-width: 52%;
    min-width: 0;
  }

  .caption-works :global(.evidence-badge),
  .mobile-detail-works :global(.evidence-badge) {
    display: inline-flex;
    max-width: 100%;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.32rem;
    padding: 0.22rem 0.4rem;
    border: 1px solid rgb(212 212 212);
    border-radius: 0.35rem;
    background: rgb(245 245 245);
    overflow-wrap: anywhere;
  }

  .caption-works :global(.evidence-name),
  .mobile-detail-works :global(.evidence-name) {
    min-width: 0;
    font-size: 0.65rem;
    font-weight: 700;
    line-height: 1.25;
    color: rgb(64 64 64);
    overflow-wrap: anywhere;
  }

  .caption-works :global(.evidence-refs),
  .mobile-detail-works :global(.evidence-refs) {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.2rem;
  }

  .caption-works :global(.evidence-ref),
  .mobile-detail-works :global(.evidence-ref) {
    display: inline-flex;
    min-width: 1.5rem;
    min-height: 1.5rem;
    align-items: center;
    justify-content: center;
    padding: 0.12rem 0.28rem;
    border: 1px solid transparent;
    border-radius: 0.24rem;
    background: rgb(229 229 229);
    font-size: 0.625rem;
    font-weight: 700;
    line-height: 1;
    color: rgb(82 82 82);
    text-decoration: none;
  }

  .caption-works :global(.evidence-ref:hover),
  .caption-works :global(.evidence-ref:focus-visible),
  .mobile-detail-works :global(.evidence-ref:hover),
  .mobile-detail-works :global(.evidence-ref:focus-visible) {
    border-color: rgb(245 158 11);
    background: rgb(254 243 199);
    color: rgb(146 64 14);
    outline: 2px solid rgb(217 119 6);
    outline-offset: 1px;
  }

  .mobile-card-detail {
    display: none;
  }

  .current-next {
    display: grid;
    grid-template-columns: 118px minmax(0, 1fr);
    gap: 0.55rem;
    align-items: center;
    margin-top: 0.55rem;
