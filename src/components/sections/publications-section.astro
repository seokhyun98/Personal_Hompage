---
import publicationsData from "../../collections/publications.json";
import { getPublicationById } from "../../lib/scholarly-publications";

function highlightAuthor(authors: string) {
	return authors
		.split(/(Hwang, S\.\*?)/g)
		.map((part) =>
			part.match(/^Hwang, S\.\*?$/)
				? { type: "highlight" as const, text: part }
				: { type: "text" as const, text: part },
		);
}

function displayTag(tag: string) {
	return tag === "Poster&Workshop"
		? "Poster & Workshop"
		: tag.replace(/_/g, " ");
}

function publicationPdfPath(publicationId: string) {
	const publication = getPublicationById(publicationId);
	if (!publication)
		throw new Error(`Missing publication detail page for ${publicationId}.`);
	return publication.pdf?.path;
}

const publicationEntries = publicationsData.entries
	.filter((item) => item.group === "publication")
	.map((entry) => ({
		...entry,
		pdfPath: publicationPdfPath(entry.id),
	}));
const conferenceJournalEntries = publicationEntries.filter(
	(e) => e.id.startsWith("c.") || e.id.startsWith("j."),
);
const posterWorkshopEntries = publicationEntries.filter(
	(e) => e.id.startsWith("w.") || e.id.startsWith("p."),
);

const filterGroups = Object.entries(publicationsData.tagGroups).map(
	([name, tags]) => ({
		name,
		tags,
	}),
);

const patentEntries = publicationsData.entries.filter(
	(item) => item.group === "patent",
);
const copyrightEntries = publicationsData.entries.filter(
	(item) => item.group === "copyright",
);
---

<section id="publications" class="relative z-20 w-full max-w-5xl mx-auto mt-14 px-7 xl:px-0">
  <h2 class="text-2xl font-bold text-neutral-900 dark:text-white">
    <a href="/publications/" class="text-inherit no-underline">Publications</a>
  </h2>

  <div class="publication-filter-bar mt-5" role="group" aria-label="Filter publications">
    <div class="filter-reset">
      <span class="filter-tag-label">View</span>
      <button type="button" class="tag-filter-btn active" data-reset-filters data-filter="all" aria-pressed="true">
        All publications
      </button>
    </div>
    {
      filterGroups.map((group) => (
        <fieldset class="filter-group" data-filter-group={group.name}>
          <legend class="filter-tag-label">{group.name}</legend>
          <div class="filter-buttons">
            {group.tags.map((tag) => (
              <button type="button" class="tag-filter-btn" data-filter={tag} aria-pressed="false">
                {displayTag(tag)}
              </button>
            ))}
          </div>
        </fieldset>
      ))
    }
  </div>
  <p class="filter-status" data-filter-status role="status" aria-live="polite" aria-atomic="true">
    {publicationEntries.length} publications shown
  </p>

  <section data-publication-subsection>
    <h3 class="publication-subheading mt-6 text-sm font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Conferences & Journals</h3>
    <div class="mt-2 publications-list">
      <div class="publications-top-spacer" aria-hidden="true" />
      {
        conferenceJournalEntries.map((entry) => (
        <article id={`pub-${entry.id}`} class="publication-container rounded-lg border border-dashed border-neutral-300 p-2 dark:border-neutral-700" data-tags={entry.tags.join(" ")}>
          <div class="publication-image">
            {entry.media?.type === "animated-image" ? (
              <picture>
                <source media="(prefers-reduced-motion: reduce)" srcset={entry.media.poster} />
                <source type="image/webp" srcset={entry.media.src} />
                <img src={entry.media.poster} alt={entry.title} loading="lazy" decoding="async" />
              </picture>
            ) : (
              <img src={entry.media?.src} alt={entry.title} loading="lazy" decoding="async" />
            )}
          </div>
          <div class="publication-text">
            <div class="publication-heading">
              <div class="publication-tags">
                {entry.tags.map((tag: string) => <span class="publication-tag" data-tag={tag}>{displayTag(tag)}</span>)}
              </div>
              {entry.link ? (
                <h4 class="mt-1 text-base font-semibold text-neutral-900 dark:text-white">
                  <a href={entry.link} target="_blank" rel="noopener noreferrer" class="hover:underline decoration-dotted underline-offset-2">
                    [{entry.id}] {entry.title}
                  </a>
                </h4>
              ) : (
                <h4 class="mt-1 text-base font-semibold text-neutral-900 dark:text-white">[{entry.id}] {entry.title}</h4>
              )}
              {entry.award && <p class="publication-award mt-1 inline-block rounded-md bg-amber-200 px-2 py-1 text-xs font-semibold text-neutral-900 dark:bg-amber-900/50 dark:text-amber-100">🏆 {entry.award}</p>}
            </div>
            <div class="publication-details">
              <p class="mt-1 text-sm text-neutral-700 dark:text-neutral-300">
                {highlightAuthor(entry.authors).map((part) =>
                  part.type === "highlight" ? (
                    <span class="author-highlight font-semibold text-neutral-900 dark:text-white">{part.text}</span>
                  ) : (
                    part.text
                  )
                )}
              </p>
              <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-neutral-700 dark:text-neutral-300">
                <span class="italic">{entry.venue}</span>
                {entry.status === "Accepted" && <span class="publication-status-badge inline-block rounded px-1.5 py-0.5 text-xs font-semibold bg-[#b0c4de] text-[#2c3e50] dark:bg-[#4b5563] dark:text-[#f3f4f6]">Coming Soon</span>}
                {entry.pdfPath && (
                  <a class="publication-pdf-button" href={entry.pdfPath} target="_blank" rel="noopener noreferrer" type="application/pdf" aria-label={`Open PDF for ${entry.title} in a new tab`}>
                    PDF
                  </a>
                )}
              </p>
              {entry.status && entry.status !== "Accepted" && <p class="mt-1 text-sm font-medium text-neutral-700 dark:text-neutral-200">({entry.status})</p>}
            </div>
          </div>
        </article>
        ))
      }
    </div>
  </section>

  <section data-publication-subsection>
    <h3 class="publication-subheading mt-6 text-sm font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Posters & Workshops</h3>
    <div class="mt-2 publications-list">
      <div class="publications-top-spacer" aria-hidden="true" />
      {
        posterWorkshopEntries.map((entry) => (
        <article id={`pub-${entry.id}`} class="publication-container rounded-lg border border-dashed border-neutral-300 p-2 dark:border-neutral-700" data-tags={entry.tags.join(" ")}>
          <div class="publication-image">
            {entry.media?.type === "animated-image" ? (
              <picture>
                <source media="(prefers-reduced-motion: reduce)" srcset={entry.media.poster} />
                <source type="image/webp" srcset={entry.media.src} />
                <img src={entry.media.poster} alt={entry.title} loading="lazy" decoding="async" />
              </picture>
            ) : (
              <img src={entry.media?.src} alt={entry.title} loading="lazy" decoding="async" />
            )}
          </div>
          <div class="publication-text">
            <div class="publication-heading">
              <div class="publication-tags">
                {entry.tags.map((tag: string) => <span class="publication-tag" data-tag={tag}>{displayTag(tag)}</span>)}
              </div>
              {entry.link ? (
                <h4 class="mt-1 text-base font-semibold text-neutral-900 dark:text-white">
                  <a href={entry.link} target="_blank" rel="noopener noreferrer" class="hover:underline decoration-dotted underline-offset-2">
                    [{entry.id}] {entry.title}
                  </a>
                </h4>
              ) : (
                <h4 class="mt-1 text-base font-semibold text-neutral-900 dark:text-white">[{entry.id}] {entry.title}</h4>
              )}
              {entry.award && <p class="publication-award mt-1 inline-block rounded-md bg-amber-200 px-2 py-1 text-xs font-semibold text-neutral-900 dark:bg-amber-900/50 dark:text-amber-100">🏆 {entry.award}</p>}
            </div>
            <div class="publication-details">
              <p class="mt-1 text-sm text-neutral-700 dark:text-neutral-300">
                {highlightAuthor(entry.authors).map((part) =>
                  part.type === "highlight" ? (
                    <span class="author-highlight font-semibold text-neutral-900 dark:text-white">{part.text}</span>
                  ) : (
                    part.text
                  )
                )}
              </p>
              <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-neutral-700 dark:text-neutral-300">
                <span class="italic">{entry.venue}</span>
                {entry.status === "Accepted" && <span class="publication-status-badge inline-block rounded px-1.5 py-0.5 text-xs font-semibold bg-[#b0c4de] text-[#2c3e50] dark:bg-[#4b5563] dark:text-[#f3f4f6]">Coming Soon</span>}
                {entry.pdfPath && (
                  <a class="publication-pdf-button" href={entry.pdfPath} target="_blank" rel="noopener noreferrer" type="application/pdf" aria-label={`Open PDF for ${entry.title} in a new tab`}>
                    PDF
                  </a>
                )}
              </p>
              {entry.status && entry.status !== "Accepted" && <p class="mt-1 text-sm font-medium text-neutral-700 dark:text-neutral-200">({entry.status})</p>}
            </div>
          </div>
        </article>
        ))
      }
    </div>
  </section>

  <h3 class="publication-subheading mt-6 text-sm font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">Patents & Copyrighted Contents</h3>
  <div class="mt-2 space-y-4">
    {patentEntries.map((entry) => (
      <article id={`pub-${entry.id}`} class="publication-anchor">
        <h4 class="text-base font-semibold text-neutral-900 dark:text-white">[{entry.id}] {entry.title}</h4>
        <p class="text-sm text-neutral-700 dark:text-neutral-300">
          {highlightAuthor(entry.authors).map((part) =>
            part.type === "highlight" ? (
              <span class="author-highlight font-semibold text-neutral-900 dark:text-white">{part.text}</span>
            ) : (
              part.text
            )
          )}
        </p>
        <p class="text-sm italic text-neutral-700 dark:text-neutral-300">{entry.venue}</p>
      </article>
    ))}
    {copyrightEntries.map((entry) => (
      <article id={`pub-${entry.id}`} class="publication-anchor">
        <h4 class="text-base font-semibold text-neutral-900 dark:text-white">[{entry.id}] {entry.title}</h4>
        <p class="text-sm text-neutral-700 dark:text-neutral-300">
          {highlightAuthor(entry.authors).map((part) =>
            part.type === "highlight" ? (
              <span class="author-highlight font-semibold text-neutral-900 dark:text-white">{part.text}</span>
            ) : (
              part.text
            )
          )}
        </p>
        <p class="text-sm italic text-neutral-700 dark:text-neutral-300">{entry.venue}</p>
      </article>
    ))}
  </div>
</section>

<script is:inline define:vars={{ tagColors: publicationsData.tagColors, tagColorsDark: publicationsData.tagColorsDark, tagTextColors: publicationsData.tagTextColors, tagTextColorsDark: publicationsData.tagTextColorsDark }}>
  function applyTagColors() {
    const isDark = document.documentElement.classList.contains("dark");
    const palette = isDark ? (tagColorsDark || tagColors) : tagColors;
    const textPalette = (isDark ? tagTextColorsDark : tagTextColors) || {};
    const defaultBg = isDark ? "#374151" : "#f0f0f0";
    const defaultColor = isDark ? "#e5e7eb" : "#444";

    document.querySelectorAll(".publication-tag").forEach((tag) => {
      const key = tag.getAttribute("data-tag");
      tag.style.backgroundColor = palette[key] || defaultBg;
      tag.style.color = textPalette[key] || defaultColor;
    });

    document.querySelectorAll(".tag-filter-btn").forEach((btn) => {
      const filter = btn.getAttribute("data-filter");
      btn.style.backgroundColor = palette[filter] || defaultBg;
      btn.style.color = textPalette[filter] || defaultColor;
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    const buttons = document.querySelectorAll(".tag-filter-btn");
    const publications = document.querySelectorAll(".publication-container");
    const filterGroups = document.querySelectorAll("[data-filter-group]");
    const subsections = document.querySelectorAll("[data-publication-subsection]");
    const filterStatus = document.querySelector("[data-filter-status]");
    const resetButton = document.querySelector("[data-reset-filters]");
    let currentTagFilter = "all";

    function selectFilter(activeButton) {
      buttons.forEach((button) => {
        const isActive = button === activeButton;
        button.classList.toggle("active", isActive);
        button.setAttribute("aria-pressed", String(isActive));
      });
      currentTagFilter = activeButton?.getAttribute("data-filter") || "all";
      updateVisibility();
    }

    function updateVisibility() {
      let visibleCount = 0;

      publications.forEach((pub) => {
        const publicationTags = (pub.getAttribute("data-tags") || "").split(" ");
        const matchesFilters = currentTagFilter === "all" || publicationTags.includes(currentTagFilter);
        pub.hidden = !matchesFilters;
        if (matchesFilters) visibleCount += 1;
      });

      subsections.forEach((section) => {
        const sectionPublications = section.querySelectorAll(".publication-container");
        section.hidden = !Array.from(sectionPublications).some((publication) => !publication.hidden);
      });

      if (filterStatus) {
        filterStatus.textContent = `${visibleCount} of ${publications.length} publications shown`;
      }
    }

    function resetFilters() {
      if (resetButton) selectFilter(resetButton);
    }

    buttons.forEach((btn) => { btn.style.fontWeight = "bold"; });
    applyTagColors();

    const observer = new MutationObserver(applyTagColors);
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });

    filterGroups.forEach((group) => {
      const groupButtons = group.querySelectorAll(".tag-filter-btn");
      groupButtons.forEach((button) => {
        button.addEventListener("click", () => {
          selectFilter(button);
        });
      });
    });

    resetButton?.addEventListener("click", resetFilters);

    function revealPublicationFromHash({ scroll = false } = {}) {
      const id = decodeURIComponent(window.location.hash.slice(1));
      if (!id.startsWith("pub-")) return;
      const target = document.getElementById(id);
      if (!target?.matches(".publication-container")) return;

      if (target.hidden) resetFilters();
      if (scroll) {
        requestAnimationFrame(() => target.scrollIntoView({ block: "start" }));
      }
    }

    document.addEventListener("click", (event) => {
      const anchor = event.target instanceof Element ? event.target.closest('a[href^="#pub-"]') : null;
      if (!anchor) return;
      const id = anchor.getAttribute("href")?.slice(1);
      const target = id ? document.getElementById(id) : null;
      if (target?.matches(".publication-container") && target.hidden) {
        resetFilters();
        requestAnimationFrame(() => target.scrollIntoView({ block: "start" }));
      }
    });

    window.addEventListener("hashchange", () => revealPublicationFromHash({ scroll: true }));
    updateVisibility();
    revealPublicationFromHash();
  });
</script>

<style>
  .publications-list {
    display: flex;
    flex-direction: column;
  }

  .publications-top-spacer {
    flex-shrink: 0;
    height: 0.0rem;
    min-height: 0.0rem;
  }

  .publication-container,
  .publication-anchor {
    scroll-margin-top: 6rem;
  }

  .publication-container:target,
  .publication-anchor:target {
    animation: pub-target-flash 1.8s ease;
  }

  @keyframes pub-target-flash {
    0% {
      background-color: rgba(251, 191, 36, 0.3);
    }
    100% {
      background-color: transparent;
    }
  }

  .publication-container {
    display: flex;
    align-items: center;
    gap: 16px;
    overflow: hidden;
    max-height: 600px;
    opacity: 1;
    margin-top: 0.75rem;
    transition: opacity 0.3s ease, max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1), margin 0.3s ease, padding 0.3s ease, border-width 0.3s ease;
  }

  .publication-container[hidden] {
    display: none;
  }

  .publication-image {
    flex: 1;
    max-width: 260px;
  }

  .publication-image picture {
    display: block;
  }

  .publication-image img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 8px;
  }

  .publication-text {
    flex: 4;
  }

  .publication-heading,
  .publication-details {
    min-width: 0;
  }

  .publication-heading h4 {
    overflow-wrap: anywhere;
  }

  .publication-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .publication-tag {
    display: inline-block;
    border-radius: 5px;
    font-size: 12px;
    font-weight: 600;
    padding: 2px 6px;
    color: #444;
    cursor: default;
    transition: background-color 0.2s, color 0.2s;
  }

  .author-highlight {
    background: linear-gradient(transparent 60%, rgba(251, 191, 36, 0.4) 60%);
    padding: 0 1px;
  }

  html.dark .author-highlight {
    background: linear-gradient(transparent 60%, rgba(251, 191, 36, 0.35) 60%);
  }

  .publication-status-badge {
    border-radius: 5px;
    font-size: 12px;
    padding: 2px 6px;
    font-weight: 600;
  }

  .publication-pdf-button {
    display: inline-flex;
    min-height: 2rem;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(212 212 212);
    border-radius: 5px;
    background: rgb(250 250 250);
    padding: 0.25rem 0.65rem;
    color: rgb(64 64 64);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: background-color 0.2s, border-color 0.2s, color 0.2s;
  }

  .publication-pdf-button:hover {
    border-color: rgb(115 115 115);
    background: rgb(245 245 245);
    color: rgb(23 23 23);
  }

  html.dark .publication-pdf-button {
    border-color: rgb(82 82 82);
    background: rgb(38 38 38);
    color: rgb(245 245 245);
  }

  html.dark .publication-pdf-button:hover {
    border-color: rgb(163 163 163);
    background: rgb(64 64 64);
    color: white;
  }

  .publication-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 0.7rem 0.85rem;
  }

  .filter-reset,
  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .filter-group {
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .filter-buttons {
    display: flex;
    flex-wrap: nowrap;
    gap: 0.42rem;
  }

  .filter-tag-label {
    padding-left: 2px;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1.2;
    color: rgb(115 115 115);
    white-space: nowrap;
  }

  html.dark .filter-tag-label {
    color: rgb(163 163 163);
  }

  .tag-filter-btn {
    min-height: 2rem;
    cursor: pointer;
    border-radius: 6px;
    border: 1px solid rgb(0 0 0 / 0.09);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
    font-size: 13px;
    padding: 4px 8px;
    transition: background-color 0.2s, color 0.2s, box-shadow 0.2s, border-color 0.2s;
  }

  .tag-filter-btn.active {
    outline: 2px solid #555;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
  }

  .tag-filter-btn:focus-visible,
  .publication-text a:focus-visible {
    outline: 2px solid rgb(180 83 9);
    outline-offset: 2px;
  }

  html.dark .tag-filter-btn {
    border-color: rgb(255 255 255 / 0.14);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
  }

  html.dark .tag-filter-btn.active {
    outline: 2px solid #9ca3af;
  }

  html.dark .tag-filter-btn:focus-visible,
  html.dark .publication-text a:focus-visible {
    outline-color: rgb(251 191 36);
  }

  .filter-status {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: rgb(82 82 82);
  }

  html.dark .filter-status {
    color: rgb(212 212 212);
  }

  @media (max-width: 768px) {
    .publication-filter-bar {
      align-items: stretch;
    }

    .filter-reset,
    .filter-group {
      width: 100%;
    }

    .filter-buttons {
      flex-wrap: wrap;
    }

    .filter-reset .tag-filter-btn {
      width: fit-content;
    }

    .publication-container {
      display: grid;
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-items: start;
      gap: 0.5rem 0.75rem;
    }

    .publication-image {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
      width: 100%;
      max-width: none;
    }

    .publication-text {
      display: contents;
    }

    .publication-heading {
      display: contents;
    }

    .publication-heading .publication-tags {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      gap: 3px;
    }

    .publication-heading h4,
    .publication-award,
    .publication-details {
      grid-column: 1 / -1;
    }

    .publication-heading h4 {
      grid-row: 2;
      margin-top: 0;
      font-size: 0.875rem;
      line-height: 1.35;
    }

    .publication-award {
      width: fit-content;
      margin-top: 0;
    }

    .publication-heading .publication-tag {
      width: 100%;
      padding: 2px 5px;
      font-size: 11px;
      line-height: 1.2;
      text-align: center;
      overflow-wrap: normal;
      word-break: normal;
      hyphens: none;
      text-wrap: balance;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .publication-container,
    .publication-tag,
    .tag-filter-btn {
      transition: none;
    }

    .publication-container:target,
    .publication-anchor:target {
      animation: none;
    }
  }
</style>
